{
  "name": "WOLFBOT",
  "version": "1.1.5",
  "description": "A WhatsApp bot using Baileys with auto-restart prefix system and heartbeat monitor",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "silent-wolf",
    "auto-restart",
    "prefix",
    "heartbeat",
    "monitor",
    "session-protection"
  ],
  "homepage": "https://github.com/SilentWolf-Kenya/silentwolf#readme",
  "bugs": {
    "url": "https://github.com/SilentWolf-Kenya/silentwolf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentWolf-Kenya/silentwolf.git"
  },
  "license": "MIT",
  "author": "Silent Wolf",
  "type": "module",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "postinstall": "node scripts/patch-modules.cjs 2>/dev/null || true",
    "start": "node --no-warnings index.js"
    "deploy": "node restart.js",
    "auto": "node auto_restart.js",
    "bot": "node --no-warnings index.js",
    "setup": "node setup_prefix.js",
    "dev": "node --no-warnings index.js",
    "test": "echo \"No tests specified\" && exit 0",
    "status": "node check_status.js",
    "heartbeat": "node heartbeat.js",
    "monitor": "node heartbeat.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:status": "pm2 status",
    "session:check": "node scripts/check-session.js",
    "health": "node scripts/health-check.js",
    "clean": "node scripts/cleanup.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@iamtraction/google-translate": "^2.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "mumaker": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "file-type": "^19.0.0",
    "form-data": "^4.0.0",
    "gifted-btns": "^1.0.2",
    "glob": "^11.0.0",
    "jsdom": "^24.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "node-webpmux": "^3.2.1",
    "openai": "^4.0.0",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "ruhend-scraper": "^9.0.8",
    "sql.js": "^1.10.3",
    "systeminformation": "^5.22.0",
    "ws": "^8.17.0"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2",
    "formdata-node": "^6.0.3",
    "qrcode": "^1.5.3",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "pm2": "^5.3.1"
  },
  "engines": {
    "node": ">=20.x"
  }
